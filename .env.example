NODE_ENV=development
PORT=3010
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://compliance_svc:<DB_PASSWORD_COMPLIANCE>@localhost:5432/compliance_db
STAFF_JWT_SECRET=
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
# Umbral de la regla propia de AML (opcional; este es el valor por defecto):
# volumen de salida de una cuenta en 30 dias que genera un SAR automatico.
COMPLIANCE_AML_VOLUME_THRESHOLD=50000000
