NODE_ENV=development
PORT=3010
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://compliance_svc:<DB_PASSWORD_COMPLIANCE>@localhost:5432/compliance_db
STAFF_JWT_SECRET=
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
# Umbral de la regla propia de AML (opcional; este es el valor por defecto):
# volumen de salida de una cuenta en 30 dias que genera un SAR automatico.
COMPLIANCE_AML_VOLUME_THRESHOLD=50000000

# Opcionales (estos son los valores por defecto).
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=compliance-service.events
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000

# Puerto de /metrics para Prometheus (solo red privada; no es el puerto público). "off" lo apaga.
METRICS_PORT=9100
